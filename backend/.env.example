# Server Configuration
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Google Sheets API Credentials
# --- Development: point to local key file ---
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# --- Production: paste the full JSON key as a single minified line ---
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Supabase — persistent store for faculty review decisions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here